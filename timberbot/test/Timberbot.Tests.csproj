<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <!-- Share source files that have no Unity/Timberborn dependencies -->
  <ItemGroup>
    <Compile Include="..\src\TimberbotJw.cs" Link="Shared\TimberbotJw.cs" />
    <Compile Include="..\src\TimberbotPure.cs" Link="Shared\TimberbotPure.cs" />
    <Compile Include="..\src\TimberbotAgentState.cs" Link="Shared\TimberbotAgentState.cs" />
    <Compile Include="..\src\TimberbotWebSocketServer.cs" Link="Shared\TimberbotWebSocketServer.cs" />
  </ItemGroup>

  <!-- Ship openapi.yaml + TimberbotHttpServer.cs source next to the test assembly so
       OpenApiContractTests can read both at runtime. The .cs file is treated as
       raw content (NOT compiled - it depends on Unity/Bindito). -->
  <ItemGroup>
    <None Include="..\..\openapi.yaml" Link="openapi.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\src\TimberbotHttpServer.cs" Link="TimberbotHttpServer.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\python\tests\fixtures\openapi\*.json"
          Link="fixtures\openapi\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Stub out the Newtonsoft dependency used by TimberbotJw.Prop(string, object) -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
